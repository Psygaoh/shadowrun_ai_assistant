# --- Database (Supabase Postgres or local Postgres) ---
# Replace placeholders with the connection string copied from
# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL="postgresql://<db_user>:<db_password>@db.<project_ref>.supabase.co:5432/postgres?schema=public"

# --- Supabase client keys (optional, for client-side access later) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project_ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<public-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- NextAuth configuration ---
# Generate once locally: `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"
# Local dev base URL; override with production URL on Vercel.
NEXTAUTH_URL="http://localhost:3000"

# --- Bootstrap admin user for seeding ---
INITIAL_ADMIN_USERNAME="shadowrunner"
INITIAL_ADMIN_PASSWORD="shadowrun"
