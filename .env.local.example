# Variables utilisées pendant le développement local.
# Copiez ce fichier en .env.local et adaptez les valeurs à votre machine.

# Connexion à votre base Postgres locale (utilisée par Prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shadowrun_local"
# URL directe (sans pgbouncer). Identique en local.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shadowrun_local"

# Variables Supabase pour l'usage côté client/Edge (à compléter si vous en avez besoin dans l'app).
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="dev-anon-key"
# Clé de service uniquement utilisée côté serveur (API routes, scripts, migrations, etc.).
SUPABASE_SERVICE_ROLE_KEY="dev-service-role-key"
